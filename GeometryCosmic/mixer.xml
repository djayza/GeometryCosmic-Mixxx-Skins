<!DOCTYPE template>
<!--
  Two channel mixer with master meter and crossfader.
-->
<Template>
  <WidgetGroup>
    <ObjectName>Mixer</ObjectName>
    <Layout>vertical</Layout>
    <Size>262f,-1min</Size>
    <Children>

      <WidgetGroup>
        <Layout>horizontal</Layout>
        <SizePolicy>f,me</SizePolicy>
        <Children>
          <Template src="skin:mixer_channel.xml">
            <SetVariable name="i">1</SetVariable>
            <SetVariable name="color"><Variable name="DeckColor1"/></SetVariable>
          </Template>

          <WidgetGroup>
            <ObjectName>MasterMeterColumn</ObjectName>
            <Layout>vertical</Layout>
            <Size>28f,-1me</Size>
            <Children>
              <Label>
                <ObjectName>ChannelLabelMaster</ObjectName>
                <Text>MST</Text>
                <Size>-1me,18f</Size>
              </Label>
              <WidgetGroup>
                <Layout>horizontal</Layout>
                <SizePolicy>me,me</SizePolicy>
                <Children>
                  <Template src="skin:vumeter.xml">
                    <SetVariable name="group">[Main]</SetVariable>
                    <SetVariable name="side">left</SetVariable>
                    <SetVariable name="tip_meter">main_VuMeterL</SetVariable>
                    <SetVariable name="tip_clip">main_peak_indicator_left</SetVariable>
                  </Template>
                  <Template src="skin:vumeter.xml">
                    <SetVariable name="group">[Main]</SetVariable>
                    <SetVariable name="side">right</SetVariable>
                    <SetVariable name="tip_meter">main_VuMeterR</SetVariable>
                    <SetVariable name="tip_clip">main_peak_indicator_right</SetVariable>
                  </Template>
                </Children>
              </WidgetGroup>
              <WidgetGroup><Layout>vertical</Layout><Size>1min,28f</Size><Children/></WidgetGroup>
            </Children>
          </WidgetGroup>

          <Template src="skin:mixer_channel.xml">
            <SetVariable name="i">2</SetVariable>
            <SetVariable name="color"><Variable name="DeckColor2"/></SetVariable>
          </Template>
        </Children>
      </WidgetGroup>

      <WidgetGroup>
        <ObjectName>CrossfaderRow</ObjectName>
        <Layout>horizontal</Layout>
        <Size>-1me,40f</Size>
        <Children>
          <Label>
            <ObjectName>XfaderLabel</ObjectName>
            <Text>A</Text>
            <Size>12f,-1me</Size>
          </Label>
          <SliderComposed>
            <TooltipId>crossfader</TooltipId>
            <ObjectName>Crossfader</ObjectName>
            <SizePolicy>me,f</SizePolicy>
            <MinimumSize>120,34</MinimumSize>
            <MaximumSize>400,34</MaximumSize>
            <Slider scalemode="STRETCH">images/slider_xfader.svg</Slider>
            <Handle scalemode="STRETCH_ASPECT">images/handle_xfader.svg</Handle>
            <Horizontal>true</Horizontal>
            <Connection>
              <ConfigKey>[Master],crossfader</ConfigKey>
              <EmitOnDownPress>false</EmitOnDownPress>
            </Connection>
          </SliderComposed>
          <Label>
            <ObjectName>XfaderLabel</ObjectName>
            <Text>B</Text>
            <Size>12f,-1me</Size>
          </Label>
        </Children>
      </WidgetGroup>

    </Children>
  </WidgetGroup>
</Template>

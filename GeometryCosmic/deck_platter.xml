<!DOCTYPE template>
<!--
  Jog wheel with loop / transport buttons on the left and tempo controls on the right.
  Variables: i, group, color
-->
<Template>
  <WidgetGroup>
    <ObjectName>PlatterRow</ObjectName>
    <Layout>horizontal</Layout>
    <SizePolicy>me,min</SizePolicy>
    <Children>

      <!-- LEFT PANEL: loops, quantize, jump, search -->
      <WidgetGroup>
        <ObjectName>SidePanel</ObjectName>
        <Layout>vertical</Layout>
        <Size>118f,-1min</Size>
        <Children>
          <Label>
            <ObjectName>PanelCaption</ObjectName>
            <Text>LOOP</Text>
          </Label>
          <WidgetGroup>
            <Layout>horizontal</Layout>
            <Children>
              <Template src="skin:btn_push.xml">
                <SetVariable name="ObjectName">PanelButton</SetVariable>
                <SetVariable name="TooltipId">loop_in</SetVariable>
                <SetVariable name="Text">IN</SetVariable>
                <SetVariable name="Control"><Variable name="group"/>,loop_in</SetVariable>
                <SetVariable name="MinimumSize">30,26</SetVariable>
                <SetVariable name="MaximumSize">80,26</SetVariable>
                <SetVariable name="SizePolicy">me,f</SetVariable>
              </Template>
              <Template src="skin:btn_push.xml">
                <SetVariable name="ObjectName">PanelButton</SetVariable>
                <SetVariable name="TooltipId">loop_out</SetVariable>
                <SetVariable name="Text">OUT</SetVariable>
                <SetVariable name="Control"><Variable name="group"/>,loop_out</SetVariable>
                <SetVariable name="MinimumSize">30,26</SetVariable>
                <SetVariable name="MaximumSize">80,26</SetVariable>
                <SetVariable name="SizePolicy">me,f</SetVariable>
              </Template>
            </Children>
          </WidgetGroup>
          <WidgetGroup>
            <Layout>horizontal</Layout>
            <Children>
              <Template src="skin:btn_display.xml">
                <SetVariable name="ObjectName">PanelButton</SetVariable>
                <SetVariable name="TooltipId">reloop_toggle</SetVariable>
                <SetVariable name="Text">RELOOP</SetVariable>
                <SetVariable name="LeftClickIsPushButton">true</SetVariable>
                <SetVariable name="EmitOnPressAndRelease">true</SetVariable>
                <SetVariable name="LControl"><Variable name="group"/>,reloop_toggle</SetVariable>
                <SetVariable name="RControl"><Variable name="group"/>,reloop_andstop</SetVariable>
                <SetVariable name="DControl"><Variable name="group"/>,loop_enabled</SetVariable>
                <SetVariable name="Icon"></SetVariable>
                <SetVariable name="IconOn"></SetVariable>
                <SetVariable name="MinimumSize">30,26</SetVariable>
                <SetVariable name="MaximumSize">120,26</SetVariable>
                <SetVariable name="SizePolicy">me,f</SetVariable>
              </Template>
            </Children>
          </WidgetGroup>
          <WidgetGroup>
            <Layout>horizontal</Layout>
            <Children>
              <Template src="skin:btn_display.xml">
                <SetVariable name="ObjectName">PanelButton</SetVariable>
                <SetVariable name="TooltipId">beatloop_activate</SetVariable>
                <SetVariable name="Text">4 BEAT</SetVariable>
                <SetVariable name="LeftClickIsPushButton">true</SetVariable>
                <SetVariable name="EmitOnPressAndRelease">true</SetVariable>
                <SetVariable name="LControl"><Variable name="group"/>,beatloop_4_toggle</SetVariable>
                <SetVariable name="RControl"><Variable name="group"/>,beatloop_4_toggle</SetVariable>
                <SetVariable name="DControl"><Variable name="group"/>,beatloop_4_enabled</SetVariable>
                <SetVariable name="Icon"></SetVariable>
                <SetVariable name="IconOn"></SetVariable>
                <SetVariable name="MinimumSize">30,26</SetVariable>
                <SetVariable name="MaximumSize">120,26</SetVariable>
                <SetVariable name="SizePolicy">me,f</SetVariable>
              </Template>
            </Children>
          </WidgetGroup>
          <WidgetGroup>
            <Layout>horizontal</Layout>
            <Children>
              <Template src="skin:btn_push.xml">
                <SetVariable name="ObjectName">PanelButton</SetVariable>
                <SetVariable name="TooltipId">loop_halve</SetVariable>
                <SetVariable name="Text">1/2X</SetVariable>
                <SetVariable name="Control"><Variable name="group"/>,loop_halve</SetVariable>
                <SetVariable name="MinimumSize">30,26</SetVariable>
                <SetVariable name="MaximumSize">80,26</SetVariable>
                <SetVariable name="SizePolicy">me,f</SetVariable>
              </Template>
              <Template src="skin:btn_push.xml">
                <SetVariable name="ObjectName">PanelButton</SetVariable>
                <SetVariable name="TooltipId">loop_double</SetVariable>
                <SetVariable name="Text">2X</SetVariable>
                <SetVariable name="Control"><Variable name="group"/>,loop_double</SetVariable>
                <SetVariable name="MinimumSize">30,26</SetVariable>
                <SetVariable name="MaximumSize">80,26</SetVariable>
                <SetVariable name="SizePolicy">me,f</SetVariable>
              </Template>
            </Children>
          </WidgetGroup>
          <Label>
            <ObjectName>PanelCaption</ObjectName>
            <Text>BEAT JUMP / SEARCH</Text>
          </Label>
          <WidgetGroup>
            <Layout>horizontal</Layout>
            <Children>
              <Template src="skin:btn_push.xml">
                <SetVariable name="ObjectName">PanelButton</SetVariable>
                <SetVariable name="TooltipId">beatjump_backward</SetVariable>
                <SetVariable name="Text">&lt; JUMP</SetVariable>
                <SetVariable name="Control"><Variable name="group"/>,beatjump_backward</SetVariable>
                <SetVariable name="MinimumSize">30,26</SetVariable>
                <SetVariable name="MaximumSize">80,26</SetVariable>
                <SetVariable name="SizePolicy">me,f</SetVariable>
              </Template>
              <Template src="skin:btn_push.xml">
                <SetVariable name="ObjectName">PanelButton</SetVariable>
                <SetVariable name="TooltipId">beatjump_forward</SetVariable>
                <SetVariable name="Text">JUMP &gt;</SetVariable>
                <SetVariable name="Control"><Variable name="group"/>,beatjump_forward</SetVariable>
                <SetVariable name="MinimumSize">30,26</SetVariable>
                <SetVariable name="MaximumSize">80,26</SetVariable>
                <SetVariable name="SizePolicy">me,f</SetVariable>
              </Template>
            </Children>
          </WidgetGroup>
          <WidgetGroup>
            <Layout>horizontal</Layout>
            <Children>
              <Template src="skin:btn_push.xml">
                <SetVariable name="ObjectName">PanelButton</SetVariable>
                <SetVariable name="TooltipId">back_start</SetVariable>
                <SetVariable name="Text">&lt;&lt;</SetVariable>
                <SetVariable name="Control"><Variable name="group"/>,back</SetVariable>
                <SetVariable name="MinimumSize">30,26</SetVariable>
                <SetVariable name="MaximumSize">80,26</SetVariable>
                <SetVariable name="SizePolicy">me,f</SetVariable>
              </Template>
              <Template src="skin:btn_push.xml">
                <SetVariable name="ObjectName">PanelButton</SetVariable>
                <SetVariable name="TooltipId">fwd_end</SetVariable>
                <SetVariable name="Text">&gt;&gt;</SetVariable>
                <SetVariable name="Control"><Variable name="group"/>,fwd</SetVariable>
                <SetVariable name="MinimumSize">30,26</SetVariable>
                <SetVariable name="MaximumSize">80,26</SetVariable>
                <SetVariable name="SizePolicy">me,f</SetVariable>
              </Template>
            </Children>
          </WidgetGroup>
        </Children>
      </WidgetGroup>

      <WidgetGroup><Layout>horizontal</Layout><Size>0me,1min</Size><Children/></WidgetGroup>

      <!-- JOG WHEEL -->
      <WidgetGroup>
        <ObjectName>JogHolder</ObjectName>
        <Layout>vertical</Layout>
        <Size>192f,192f</Size>
        <Children>
          <Spinny>
            <TooltipId>spinny</TooltipId>
            <ObjectName>Spinny<Variable name="i"/></ObjectName>
            <Size>184f,184f</Size>
            <Group><Variable name="group"/></Group>
            <PathBackground scalemode="STRETCH">images/jog_bg_<Variable name="color"/>.svg</PathBackground>
            <PathForeground scalemode="STRETCH">images/jog_fg.svg</PathForeground>
            <PathGhost scalemode="STRETCH">images/jog_ghost.svg</PathGhost>
            <PathMask scalemode="STRETCH">images/jog_mask_<Variable name="color"/>.svg</PathMask>
            <ShowCover>true</ShowCover>
          </Spinny>
        </Children>
      </WidgetGroup>

      <WidgetGroup><Layout>horizontal</Layout><Size>0me,1min</Size><Children/></WidgetGroup>

      <!-- RIGHT PANEL: sync, key lock, tempo -->
      <WidgetGroup>
        <ObjectName>SidePanel</ObjectName>
        <Layout>vertical</Layout>
        <Size>104f,-1min</Size>
        <Children>
          <WidgetGroup>
            <Layout>horizontal</Layout>
            <Children>
              <Template src="skin:btn_toggle.xml">
                <SetVariable name="ObjectName">SyncButton</SetVariable>
                <SetVariable name="TooltipId">sync_enabled</SetVariable>
                <SetVariable name="Text">SYNC</SetVariable>
                <SetVariable name="Control"><Variable name="group"/>,sync_enabled</SetVariable>
                <SetVariable name="MinimumSize">30,26</SetVariable>
                <SetVariable name="MaximumSize">80,26</SetVariable>
                <SetVariable name="SizePolicy">me,f</SetVariable>
              </Template>
              <Template src="skin:btn_toggle.xml">
                <SetVariable name="ObjectName">MasterButton</SetVariable>
                <SetVariable name="TooltipId">sync_leader</SetVariable>
                <SetVariable name="Text">MSTR</SetVariable>
                <SetVariable name="Control"><Variable name="group"/>,sync_leader</SetVariable>
                <SetVariable name="MinimumSize">30,26</SetVariable>
                <SetVariable name="MaximumSize">80,26</SetVariable>
                <SetVariable name="SizePolicy">me,f</SetVariable>
              </Template>
            </Children>
          </WidgetGroup>
          <WidgetGroup>
            <Layout>horizontal</Layout>
            <Children>
              <Template src="skin:btn_toggle.xml">
                <SetVariable name="ObjectName">PanelButton</SetVariable>
                <SetVariable name="TooltipId">keylock</SetVariable>
                <SetVariable name="Text">KEY LOCK</SetVariable>
                <SetVariable name="Control"><Variable name="group"/>,keylock</SetVariable>
                <SetVariable name="MinimumSize">30,26</SetVariable>
                <SetVariable name="MaximumSize">120,26</SetVariable>
                <SetVariable name="SizePolicy">me,f</SetVariable>
              </Template>
            </Children>
          </WidgetGroup>
          <WidgetGroup>
            <Layout>horizontal</Layout>
            <Children>
              <Template src="skin:btn_toggle.xml">
                <SetVariable name="ObjectName">PanelButton</SetVariable>
                <SetVariable name="TooltipId">quantize</SetVariable>
                <SetVariable name="Text">QUANTIZE</SetVariable>
                <SetVariable name="Control"><Variable name="group"/>,quantize</SetVariable>
                <SetVariable name="MinimumSize">30,26</SetVariable>
                <SetVariable name="MaximumSize">140,26</SetVariable>
                <SetVariable name="SizePolicy">me,f</SetVariable>
              </Template>
            </Children>
          </WidgetGroup>
          <WidgetGroup>
            <Layout>horizontal</Layout>
            <Children>
              <Template src="skin:btn_push.xml">
                <SetVariable name="ObjectName">PanelButton</SetVariable>
                <SetVariable name="TooltipId">reverse</SetVariable>
                <SetVariable name="Text">REV</SetVariable>
                <SetVariable name="Control"><Variable name="group"/>,reverse</SetVariable>
                <SetVariable name="MinimumSize">30,26</SetVariable>
                <SetVariable name="MaximumSize">66,26</SetVariable>
                <SetVariable name="SizePolicy">me,f</SetVariable>
              </Template>
              <Template src="skin:btn_toggle.xml">
                <SetVariable name="ObjectName">SlipButton</SetVariable>
                <SetVariable name="TooltipId">slip_mode</SetVariable>
                <SetVariable name="Text">SLIP</SetVariable>
                <SetVariable name="Control"><Variable name="group"/>,slip_enabled</SetVariable>
                <SetVariable name="MinimumSize">30,26</SetVariable>
                <SetVariable name="MaximumSize">70,26</SetVariable>
                <SetVariable name="SizePolicy">me,f</SetVariable>
              </Template>
            </Children>
          </WidgetGroup>
          <Label>
            <ObjectName>PanelCaption</ObjectName>
            <Text>TEMPO</Text>
          </Label>
          <WidgetGroup>
            <Layout>horizontal</Layout>
            <SizePolicy>me,me</SizePolicy>
            <Children>
              <SliderComposed>
                <TooltipId>rate</TooltipId>
                <ObjectName>TempoSlider</ObjectName>
                <SizePolicy>f,me</SizePolicy>
                <MinimumSize>44,90</MinimumSize>
                <MaximumSize>44,400</MaximumSize>
                <Slider scalemode="STRETCH">images/slider_tempo.svg</Slider>
                <Handle scalemode="STRETCH_ASPECT">images/handle_tempo_<Variable name="color"/>.svg</Handle>
                <Horizontal>false</Horizontal>
                <Connection>
                  <ConfigKey><Variable name="group"/>,rate</ConfigKey>
                </Connection>
              </SliderComposed>
              <WidgetGroup>
                <Layout>vertical</Layout>
                <SizePolicy>me,me</SizePolicy>
                <Children>
                  <Template src="skin:btn_push.xml">
                    <SetVariable name="ObjectName">PanelButton</SetVariable>
                    <SetVariable name="TooltipId">rate_temp_up_rate_temp_up_small</SetVariable>
                    <SetVariable name="Text">+</SetVariable>
                    <SetVariable name="Control"><Variable name="group"/>,rate_temp_up</SetVariable>
                    <SetVariable name="MinimumSize">24,26</SetVariable>
                    <SetVariable name="MaximumSize">40,26</SetVariable>
                    <SetVariable name="SizePolicy">me,f</SetVariable>
                  </Template>
                  <WidgetGroup><Layout>vertical</Layout><Size>1min,0me</Size><Children/></WidgetGroup>
                  <Template src="skin:btn_push.xml">
                    <SetVariable name="ObjectName">PanelButton</SetVariable>
                    <SetVariable name="TooltipId">rate_temp_down_rate_temp_down_small</SetVariable>
                    <SetVariable name="Text">-</SetVariable>
                    <SetVariable name="Control"><Variable name="group"/>,rate_temp_down</SetVariable>
                    <SetVariable name="MinimumSize">24,26</SetVariable>
                    <SetVariable name="MaximumSize">40,26</SetVariable>
                    <SetVariable name="SizePolicy">me,f</SetVariable>
                  </Template>
                </Children>
              </WidgetGroup>
            </Children>
          </WidgetGroup>
        </Children>
      </WidgetGroup>

    </Children>
  </WidgetGroup>
</Template>

<!DOCTYPE skin>
<skin>
  <manifest>
    <title>GeometryCosmic</title>
    <author>Claude</author>
    <version>1.0.0</version>
    <description>GeometryCosmic: a CDJ-style two-deck skin with a big display, jog wheel cover art, hot cue pads, channel mixer and Beat FX. Built for the Pioneer DDJ-400 mapping.</description>
    <language>en</language>
    <license>GPLv2 or later</license>
    <attributes>
      <!-- Everything the Pioneer DDJ-400 mapping talks to must exist. -->
      <attribute config_key="[App],num_decks">2</attribute>
      <attribute config_key="[App],num_samplers">8</attribute>
      <attribute config_key="[App],num_preview_decks">1</attribute>

      <attribute persist="true" config_key="[Skin],show_fx">1</attribute>
      <attribute config_key="[Skin],show_samplers">0</attribute>
      <attribute persist="true" config_key="[Skin],show_intro_outro_cues">1</attribute>
      <!-- 1 = show remaining time only (matches the CDJ-style REMAIN readout).
           Not persisted: this control already exists by the time the skin
           loads, so it must be force-set every load rather than "persisted"
           (persisted skin attributes are silently skipped for controls that
           already exist, which is why this needs persist="false" here). -->
      <attribute persist="false" config_key="[Controls],ShowDurationRemaining">1</attribute>
      <attribute config_key="[Skin],show_maximized_library">0</attribute>

      <!-- The mapping drives Beat FX on unit 1: show the focus highlight. -->
      <attribute config_key="[EffectRack1_EffectUnit1],show_focus">1</attribute>
    </attributes>
  </manifest>

  <Schemes>
    <Scheme>
      <Name>Silverline</Name>
      <Style src="skin:style.qss"/>
      <SetVariable name="DeckColor1">silver</SetVariable>
      <SetVariable name="DeckColor2">silver</SetVariable>
      <SetVariable name="DeckSignal1">#c7cbd1</SetVariable>
      <SetVariable name="DeckSignal2">#c7cbd1</SetVariable>
    </Scheme>
    <Scheme>
      <Name>BlueOrange</Name>
      <Style src="skin:style_classic.qss"/>
      <SetVariable name="DeckColor1">blue</SetVariable>
      <SetVariable name="DeckColor2">orange</SetVariable>
      <SetVariable name="DeckSignal1">#25a8ff</SetVariable>
      <SetVariable name="DeckSignal2">#ff8a1f</SetVariable>
    </Scheme>
  </Schemes>

  <ObjectName>Mixxx</ObjectName>
  <Style src="skin:style.qss"
         src-linux="skins:default-menu-styles-linux.qss"
         src-windows="skins:default-menu-styles-windows.qss"/>
  <Size>1240me,760me</Size>
  <Layout>horizontal</Layout>

  <Children>
    <WidgetGroup>
      <ObjectName>SkinContainer</ObjectName>
      <SizePolicy>me,me</SizePolicy>
      <Layout>vertical</Layout>
      <Children>

        <Template src="skin:toolbar.xml"/>

        <!-- Decks, mixer, effects and samplers (hidden when the library is maximised) -->
        <WidgetGroup>
          <ObjectName>PerformanceSection</ObjectName>
          <Layout>vertical</Layout>
          <SizePolicy>e,max</SizePolicy>
          <Children>

            <WidgetGroup>
              <ObjectName>DeckRow</ObjectName>
              <Layout>horizontal</Layout>
              <SizePolicy>e,max</SizePolicy>
              <Children>
                <Template src="skin:deck.xml">
                  <SetVariable name="i">1</SetVariable>
                  <SetVariable name="color"><Variable name="DeckColor1"/></SetVariable>
                  <SetVariable name="DeckSignalColor"><Variable name="DeckSignal1"/></SetVariable>
                </Template>
                <Template src="skin:mixer.xml"/>
                <Template src="skin:deck.xml">
                  <SetVariable name="i">2</SetVariable>
                  <SetVariable name="color"><Variable name="DeckColor2"/></SetVariable>
                  <SetVariable name="DeckSignalColor"><Variable name="DeckSignal2"/></SetVariable>
                </Template>
              </Children>
            </WidgetGroup>

            <WidgetGroup>
              <ObjectName>EffectsRow</ObjectName>
              <Layout>horizontal</Layout>
              <SizePolicy>e,max</SizePolicy>
              <Children>
                <Template src="skin:fx_unit_big.xml">
                  <SetVariable name="unit">1</SetVariable>
                  <SetVariable name="color">blue</SetVariable>
                </Template>
              </Children>
              <Connection>
                <ConfigKey>[Skin],show_fx</ConfigKey>
                <BindProperty>visible</BindProperty>
              </Connection>
            </WidgetGroup>

            <WidgetGroup>
              <ObjectName>SamplersSection</ObjectName>
              <Layout>vertical</Layout>
              <SizePolicy>e,max</SizePolicy>
              <Children>
                <WidgetGroup>
                  <Layout>horizontal</Layout>
                  <SizePolicy>e,max</SizePolicy>
                  <Children>
                    <Template src="skin:sampler.xml"><SetVariable name="i">1</SetVariable></Template>
                    <Template src="skin:sampler.xml"><SetVariable name="i">2</SetVariable></Template>
                    <Template src="skin:sampler.xml"><SetVariable name="i">3</SetVariable></Template>
                    <Template src="skin:sampler.xml"><SetVariable name="i">4</SetVariable></Template>
                  </Children>
                </WidgetGroup>
                <WidgetGroup>
                  <Layout>horizontal</Layout>
                  <SizePolicy>e,max</SizePolicy>
                  <Children>
                    <Template src="skin:sampler.xml"><SetVariable name="i">5</SetVariable></Template>
                    <Template src="skin:sampler.xml"><SetVariable name="i">6</SetVariable></Template>
                    <Template src="skin:sampler.xml"><SetVariable name="i">7</SetVariable></Template>
                    <Template src="skin:sampler.xml"><SetVariable name="i">8</SetVariable></Template>
                  </Children>
                </WidgetGroup>
              </Children>
              <Connection>
                <ConfigKey>[Skin],show_samplers</ConfigKey>
                <BindProperty>visible</BindProperty>
              </Connection>
            </WidgetGroup>

          </Children>
          <Connection>
            <ConfigKey>[Skin],show_maximized_library</ConfigKey>
            <BindProperty>visible</BindProperty>
            <Transform>
              <Not/>
            </Transform>
          </Connection>
        </WidgetGroup>

        <Template src="skin:library.xml"/>

      </Children>
    </WidgetGroup>
  </Children>
</skin>

<!DOCTYPE template>
<!--
  One complete CDJ-3000 style player.
  Variables: i (deck number), color (blue|orange), DeckSignalColor
-->
<Template>
  <SetVariable name="group">[Channel<Variable name="i"/>]</SetVariable>
  <WidgetGroup>
    <ObjectName>Deck<Variable name="i"/></ObjectName>
    <Layout>vertical</Layout>
    <SizePolicy>e,min</SizePolicy>
    <Children>
      <Template src="skin:deck_display.xml"/>
      <Template src="skin:deck_platter.xml"/>
      <Template src="skin:deck_pads.xml"/>
    </Children>
  </WidgetGroup>
</Template>

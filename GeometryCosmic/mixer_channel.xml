<!DOCTYPE template>
<!--
  One mixer channel strip: trim, 3-band EQ, filter, headphone cue, meter and fader.
  Variables: i, color
-->
<Template>
  <SetVariable name="group">[Channel<Variable name="i"/>]</SetVariable>
  <WidgetGroup>
    <ObjectName>ChannelStrip</ObjectName>
    <Layout>vertical</Layout>
    <SizePolicy>min,me</SizePolicy>
    <Children>

      <Label>
        <ObjectName>ChannelLabel<Variable name="i"/></ObjectName>
        <Text>CH <Variable name="i"/></Text>
        <Size>-1me,18f</Size>
      </Label>

      <Template src="skin:knob.xml">
        <SetVariable name="TooltipId">pregain</SetVariable>
        <SetVariable name="Control"><Variable name="group"/>,pregain</SetVariable>
        <SetVariable name="color">green</SetVariable>
        <SetVariable name="label">TRIM</SetVariable>
      </Template>
      <Template src="skin:knob.xml">
        <SetVariable name="TooltipId">filterHigh</SetVariable>
        <SetVariable name="Control">[EqualizerRack1_<Variable name="group"/>_Effect1],parameter3</SetVariable>
        <SetVariable name="color">blue</SetVariable>
        <SetVariable name="label">HI</SetVariable>
      </Template>
      <Template src="skin:knob.xml">
        <SetVariable name="TooltipId">filterMid</SetVariable>
        <SetVariable name="Control">[EqualizerRack1_<Variable name="group"/>_Effect1],parameter2</SetVariable>
        <SetVariable name="color">blue</SetVariable>
        <SetVariable name="label">MID</SetVariable>
      </Template>
      <Template src="skin:knob.xml">
        <SetVariable name="TooltipId">filterLow</SetVariable>
        <SetVariable name="Control">[EqualizerRack1_<Variable name="group"/>_Effect1],parameter1</SetVariable>
        <SetVariable name="color">blue</SetVariable>
        <SetVariable name="label">LOW</SetVariable>
      </Template>
      <Template src="skin:knob.xml">
        <SetVariable name="TooltipId">QuickEffectRack_super1</SetVariable>
        <SetVariable name="Control">[QuickEffectRack1_<Variable name="group"/>],super1</SetVariable>
        <SetVariable name="color">orange</SetVariable>
        <SetVariable name="label">FILTER</SetVariable>
      </Template>

      <Template src="skin:btn_toggle.xml">
        <SetVariable name="ObjectName">CueMonitorButton</SetVariable>
        <SetVariable name="TooltipId">pfl</SetVariable>
        <SetVariable name="Text">HP CUE</SetVariable>
        <SetVariable name="Control"><Variable name="group"/>,pfl</SetVariable>
        <SetVariable name="MinimumSize">70,24</SetVariable>
        <SetVariable name="MaximumSize">-1,24</SetVariable>
        <SetVariable name="SizePolicy">me,f</SetVariable>
      </Template>

      <WidgetGroup>
        <ObjectName>FaderRow</ObjectName>
        <Layout>horizontal</Layout>
        <SizePolicy>min,me</SizePolicy>
        <Children>
          <WidgetGroup><Layout>horizontal</Layout><Size>0me,1min</Size><Children/></WidgetGroup>
          <Template src="skin:vumeter.xml">
            <SetVariable name="side">left</SetVariable>
            <SetVariable name="tip_meter">channel_VuMeterL</SetVariable>
            <SetVariable name="tip_clip">channel_peak_indicator_left</SetVariable>
          </Template>
          <WidgetGroup><Layout>horizontal</Layout><Size>2f,1min</Size><Children/></WidgetGroup>
          <Template src="skin:vumeter.xml">
            <SetVariable name="side">right</SetVariable>
            <SetVariable name="tip_meter">channel_VuMeterR</SetVariable>
            <SetVariable name="tip_clip">channel_peak_indicator_right</SetVariable>
          </Template>
          <SliderComposed>
            <TooltipId>channel_volume</TooltipId>
            <ObjectName>ChannelFader</ObjectName>
            <SizePolicy>f,me</SizePolicy>
            <MinimumSize>44,90</MinimumSize>
            <MaximumSize>44,300</MaximumSize>
            <Slider scalemode="STRETCH">images/slider_vertical.svg</Slider>
            <Handle scalemode="STRETCH_ASPECT">images/handle_fader.svg</Handle>
            <Horizontal>false</Horizontal>
            <Connection>
              <ConfigKey><Variable name="group"/>,volume</ConfigKey>
              <EmitOnDownPress>false</EmitOnDownPress>
            </Connection>
          </SliderComposed>
          <WidgetGroup><Layout>horizontal</Layout><Size>0me,1min</Size><Children/></WidgetGroup>
        </Children>
      </WidgetGroup>

    </Children>
  </WidgetGroup>
</Template>

<!DOCTYPE template>
<!--
  CUE / PLAY and the eight hot cue pads.
  Variables: i, group
-->
<Template>
  <WidgetGroup>
    <ObjectName>PadRow</ObjectName>
    <Layout>horizontal</Layout>
    <Size>-1e,38f</Size>
    <Children>

      <Template src="skin:btn_display.xml">
        <SetVariable name="ObjectName">CueButton</SetVariable>
        <SetVariable name="TooltipId">cue_default_cue_gotoandstop</SetVariable>
        <SetVariable name="Text">CUE</SetVariable>
        <SetVariable name="LeftClickIsPushButton">true</SetVariable>
        <SetVariable name="EmitOnPressAndRelease">true</SetVariable>
        <SetVariable name="LControl"><Variable name="group"/>,cue_default</SetVariable>
        <SetVariable name="RControl"><Variable name="group"/>,cue_gotoandstop</SetVariable>
        <SetVariable name="DControl"><Variable name="group"/>,cue_indicator</SetVariable>
        <SetVariable name="Icon"></SetVariable>
        <SetVariable name="IconOn"></SetVariable>
        <SetVariable name="MinimumSize">52,32</SetVariable>
        <SetVariable name="MaximumSize">52,32</SetVariable>
        <SetVariable name="SizePolicy">f,f</SetVariable>
      </Template>

      <Template src="skin:btn_display.xml">
        <SetVariable name="ObjectName">PlayButton</SetVariable>
        <SetVariable name="TooltipId">play_cue_set</SetVariable>
        <SetVariable name="Text"></SetVariable>
        <SetVariable name="LeftClickIsPushButton">false</SetVariable>
        <SetVariable name="EmitOnPressAndRelease">false</SetVariable>
        <SetVariable name="LControl"><Variable name="group"/>,play</SetVariable>
        <SetVariable name="RControl"><Variable name="group"/>,cue_set</SetVariable>
        <SetVariable name="DControl"><Variable name="group"/>,play_indicator</SetVariable>
        <SetVariable name="Icon">images/ic_playpause.svg</SetVariable>
        <SetVariable name="IconOn">images/ic_playpause_on.svg</SetVariable>
        <SetVariable name="MinimumSize">52,32</SetVariable>
        <SetVariable name="MaximumSize">52,32</SetVariable>
        <SetVariable name="SizePolicy">f,f</SetVariable>
      </Template>

      <WidgetGroup><Layout>horizontal</Layout><Size>8f,1min</Size><Children/></WidgetGroup>

      <Template src="skin:hotcue_button.xml"><SetVariable name="hotcue">1</SetVariable><SetVariable name="label">A</SetVariable></Template>
      <Template src="skin:hotcue_button.xml"><SetVariable name="hotcue">2</SetVariable><SetVariable name="label">B</SetVariable></Template>
      <Template src="skin:hotcue_button.xml"><SetVariable name="hotcue">3</SetVariable><SetVariable name="label">C</SetVariable></Template>
      <Template src="skin:hotcue_button.xml"><SetVariable name="hotcue">4</SetVariable><SetVariable name="label">D</SetVariable></Template>
      <Template src="skin:hotcue_button.xml"><SetVariable name="hotcue">5</SetVariable><SetVariable name="label">E</SetVariable></Template>
      <Template src="skin:hotcue_button.xml"><SetVariable name="hotcue">6</SetVariable><SetVariable name="label">F</SetVariable></Template>
      <Template src="skin:hotcue_button.xml"><SetVariable name="hotcue">7</SetVariable><SetVariable name="label">G</SetVariable></Template>
      <Template src="skin:hotcue_button.xml"><SetVariable name="hotcue">8</SetVariable><SetVariable name="label">H</SetVariable></Template>

      <WidgetGroup><Layout>horizontal</Layout><Size>8f,1min</Size><Children/></WidgetGroup>

      <WidgetGroup>
        <Layout>vertical</Layout>
        <Size>44f,-1min</Size>
        <Children>
          <Template src="skin:btn_push.xml">
            <SetVariable name="ObjectName">PanelButton</SetVariable>
            <SetVariable name="TooltipId"></SetVariable>
            <SetVariable name="Text">LOAD</SetVariable>
            <SetVariable name="Control"><Variable name="group"/>,LoadSelectedTrack</SetVariable>
            <SetVariable name="MinimumSize">44,18</SetVariable>
            <SetVariable name="MaximumSize">44,18</SetVariable>
            <SetVariable name="SizePolicy">f,f</SetVariable>
          </Template>
          <Template src="skin:btn_push.xml">
            <SetVariable name="ObjectName">PanelButton</SetVariable>
            <SetVariable name="TooltipId">eject</SetVariable>
            <SetVariable name="Text">EJECT</SetVariable>
            <SetVariable name="Control"><Variable name="group"/>,eject</SetVariable>
            <SetVariable name="MinimumSize">44,18</SetVariable>
            <SetVariable name="MaximumSize">44,18</SetVariable>
            <SetVariable name="SizePolicy">f,f</SetVariable>
          </Template>
        </Children>
      </WidgetGroup>

    </Children>
  </WidgetGroup>
</Template>

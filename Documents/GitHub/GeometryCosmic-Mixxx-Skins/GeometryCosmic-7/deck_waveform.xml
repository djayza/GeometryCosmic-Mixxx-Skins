<!DOCTYPE template>
<!--
  Zoomed scrolling waveform.
  Variables: group, DeckSignalColor
-->
<Template>
  <Visual>
    <TooltipId>waveform_display</TooltipId>
    <ObjectName>CDJWaveform</ObjectName>
    <Group><Variable name="group"/></Group>
    <SizePolicy>e,e</SizePolicy>
    <BgColor>#060709</BgColor>
    <!-- SignalColor is the fallback used by simple (non-RGB) waveform types;
         High/Mid/Low and their RGB variants are intentionally left empty so
         Mixxx uses whatever the user picked in Preferences > Waveforms >
         Colors, instead of the skin forcing its own palette. -->
    <SignalColor><Variable name="DeckSignalColor"/></SignalColor>
    <SignalHighColor></SignalHighColor>
    <SignalMidColor></SignalMidColor>
    <SignalLowColor></SignalLowColor>
    <SignalRGBHighColor></SignalRGBHighColor>
    <SignalRGBMidColor></SignalRGBMidColor>
    <SignalRGBLowColor></SignalRGBLowColor>
    <BeatColor>#9aa0ad</BeatColor>
    <PlayPosColor>#ffffff</PlayPosColor>
    <EndOfTrackColor>#ff3b3b</EndOfTrackColor>
    <AxesColor></AxesColor>
    <Align></Align>
    <DefaultMark>
      <Align>top</Align>
      <Color>#25a8ff</Color>
      <TextColor>#000000</TextColor>
      <Text> %1 </Text>
    </DefaultMark>
    <Mark>
      <Control>cue_point</Control>
      <Text>CUE</Text>
      <Align>bottom</Align>
      <Color>#ff8a1f</Color>
      <TextColor>#000000</TextColor>
    </Mark>
    <!-- Loop -->
    <MarkRange>
      <StartControl>loop_start_position</StartControl>
      <EndControl>loop_end_position</EndControl>
      <EnabledControl>loop_enabled</EnabledControl>
      <Color>#3ddc84</Color>
      <Opacity>0.55</Opacity>
      <DisabledColor>#ffffff</DisabledColor>
      <DisabledOpacity>0.25</DisabledOpacity>
    </MarkRange>
    <Mark>
      <Control>loop_start_position</Control>
      <Text>IN</Text>
      <Align>bottom</Align>
      <Color>#3ddc84</Color>
      <TextColor>#000000</TextColor>
    </Mark>
    <Mark>
      <Control>loop_end_position</Control>
      <Text>OUT</Text>
      <Align>bottom</Align>
      <Color>#3ddc84</Color>
      <TextColor>#000000</TextColor>
    </Mark>
    <!-- Intro -->
    <MarkRange>
      <StartControl>intro_start_position</StartControl>
      <EndControl>intro_end_position</EndControl>
      <VisibilityControl>[Skin],show_intro_outro_cues</VisibilityControl>
      <Color>#25a8ff</Color>
      <Opacity>0.12</Opacity>
    </MarkRange>
    <Mark>
      <Control>intro_start_position</Control>
      <VisibilityControl>[Skin],show_intro_outro_cues</VisibilityControl>
      <Text>&#9698;</Text>
      <Align>bottom|right</Align>
      <Color>#25a8ff</Color>
      <TextColor>#000000</TextColor>
    </Mark>
    <Mark>
      <Control>intro_end_position</Control>
      <VisibilityControl>[Skin],show_intro_outro_cues</VisibilityControl>
      <Text>&#9698;</Text>
      <Align>bottom|left</Align>
      <Color>#25a8ff</Color>
      <TextColor>#000000</TextColor>
    </Mark>
    <!-- Outro -->
    <MarkRange>
      <StartControl>outro_start_position</StartControl>
      <EndControl>outro_end_position</EndControl>
      <VisibilityControl>[Skin],show_intro_outro_cues</VisibilityControl>
      <Color>#25a8ff</Color>
      <Opacity>0.12</Opacity>
    </MarkRange>
    <Mark>
      <Control>outro_start_position</Control>
      <VisibilityControl>[Skin],show_intro_outro_cues</VisibilityControl>
      <Text>&#9699;</Text>
      <Align>bottom|right</Align>
      <Color>#25a8ff</Color>
      <TextColor>#000000</TextColor>
    </Mark>
    <Mark>
      <Control>outro_end_position</Control>
      <VisibilityControl>[Skin],show_intro_outro_cues</VisibilityControl>
      <Text>&#9699;</Text>
      <Align>bottom|left</Align>
      <Color>#25a8ff</Color>
      <TextColor>#000000</TextColor>
    </Mark>
  </Visual>
</Template>

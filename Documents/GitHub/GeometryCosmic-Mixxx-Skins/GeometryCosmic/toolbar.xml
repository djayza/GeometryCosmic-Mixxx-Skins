<!DOCTYPE template>
<!--
  Top bar: logo, view toggles, master / headphone knobs, load meter and clock.
-->
<Template>
  <WidgetGroup>
    <ObjectName>ToolBar</ObjectName>
    <Layout>horizontal</Layout>
    <Size>-1me,52f</Size>
    <Children>

      <Label>
        <ObjectName>ToolBarLogo</ObjectName>
        <Text>GeometryCosmic</Text>
        <Size>175f,-1me</Size>
      </Label>

      <Template src="skin:btn_toggle.xml">
        <SetVariable name="ObjectName">ToolBarButton</SetVariable>
        <SetVariable name="TooltipId"></SetVariable>
        <SetVariable name="Text">FX</SetVariable>
        <SetVariable name="Control">[Skin],show_fx</SetVariable>
        <SetVariable name="MinimumSize">56,26</SetVariable>
        <SetVariable name="MaximumSize">56,26</SetVariable>
        <SetVariable name="SizePolicy">f,f</SetVariable>
      </Template>
      <Template src="skin:btn_toggle.xml">
        <SetVariable name="ObjectName">ToolBarButton</SetVariable>
        <SetVariable name="TooltipId"></SetVariable>
        <SetVariable name="Text">SAMPLERS</SetVariable>
        <SetVariable name="Control">[Skin],show_samplers</SetVariable>
        <SetVariable name="MinimumSize">80,26</SetVariable>
        <SetVariable name="MaximumSize">80,26</SetVariable>
        <SetVariable name="SizePolicy">f,f</SetVariable>
      </Template>
      <WidgetGroup><Layout>horizontal</Layout><Size>6f,1min</Size><Children/></WidgetGroup>
      <Template src="skin:btn_toggle.xml">
        <SetVariable name="ObjectName">ToolBarButton</SetVariable>
        <SetVariable name="TooltipId"></SetVariable>
        <SetVariable name="Text">STACK</SetVariable>
        <SetVariable name="Control">[Skin],stacked_waves</SetVariable>
        <SetVariable name="MinimumSize">64,26</SetVariable>
        <SetVariable name="MaximumSize">64,26</SetVariable>
        <SetVariable name="SizePolicy">f,f</SetVariable>
      </Template>
      <Template src="skin:btn_toggle.xml">
        <SetVariable name="ObjectName">ToolBarButton</SetVariable>
        <SetVariable name="TooltipId">maximize_library</SetVariable>
        <SetVariable name="Text">LIBRARY</SetVariable>
        <SetVariable name="Control">[Skin],show_maximized_library</SetVariable>
        <SetVariable name="MinimumSize">70,26</SetVariable>
        <SetVariable name="MaximumSize">70,26</SetVariable>
        <SetVariable name="SizePolicy">f,f</SetVariable>
      </Template>
      <Template src="skin:btn_toggle.xml">
        <SetVariable name="ObjectName">ToolBarButton</SetVariable>
        <SetVariable name="TooltipId"></SetVariable>
        <SetVariable name="Text">INTRO/OUTRO</SetVariable>
        <SetVariable name="Control">[Skin],show_intro_outro_cues</SetVariable>
        <SetVariable name="MinimumSize">96,26</SetVariable>
        <SetVariable name="MaximumSize">96,26</SetVariable>
        <SetVariable name="SizePolicy">f,f</SetVariable>
      </Template>

      <WidgetGroup><Layout>horizontal</Layout><Size>0me,1min</Size><Children/></WidgetGroup>

      <Template src="skin:knob_small.xml">
        <SetVariable name="TooltipId">main_gain</SetVariable>
        <SetVariable name="Control">[Master],gain</SetVariable>
        <SetVariable name="color">green</SetVariable>
        <SetVariable name="label">MASTER</SetVariable>
      </Template>
      <Template src="skin:knob_small.xml">
        <SetVariable name="TooltipId">headphone_gain</SetVariable>
        <SetVariable name="Control">[Master],headGain</SetVariable>
        <SetVariable name="color">blue</SetVariable>
        <SetVariable name="label">PHONES</SetVariable>
      </Template>
      <Template src="skin:knob_small.xml">
        <SetVariable name="TooltipId">headMix</SetVariable>
        <SetVariable name="Control">[Master],headMix</SetVariable>
        <SetVariable name="color">orange</SetVariable>
        <SetVariable name="label">CUE/MST</SetVariable>
      </Template>

      <WidgetGroup><Layout>horizontal</Layout><Size>10f,1min</Size><Children/></WidgetGroup>

      <WidgetGroup>
        <ObjectName>ClockGroup</ObjectName>
        <Layout>vertical</Layout>
        <Size>64f,-1min</Size>
        <Children>
          <Time>
            <ObjectName>Clock</ObjectName>
            <TooltipId>time</TooltipId>
            <Size>64f,22f</Size>
            <CustomFormat>hh:mm</CustomFormat>
          </Time>
          <VuMeter>
            <ObjectName>LatencyMeter</ObjectName>
            <TooltipId>audio_latency_usage</TooltipId>
            <Size>64f,6f</Size>
            <PathBack scalemode="STRETCH">images/meter_h_bg.svg</PathBack>
            <PathVu scalemode="STRETCH">images/meter_h.svg</PathVu>
            <Horizontal>true</Horizontal>
            <Connection>
              <ConfigKey>[App],audio_latency_usage</ConfigKey>
            </Connection>
          </VuMeter>
        </Children>
      </WidgetGroup>

    </Children>
  </WidgetGroup>
</Template>

<!DOCTYPE template>
<!--
  A small knob with a label underneath (tool bar / effects).
  Variables: TooltipId, Control, color, label
-->
<Template>
  <WidgetGroup>
    <ObjectName>KnobSmallCell</ObjectName>
    <Layout>vertical</Layout>
    <SizePolicy>min,min</SizePolicy>
    <Children>
      <KnobComposed>
        <TooltipId><Variable name="TooltipId"/></TooltipId>
        <Size>32f,32f</Size>
        <Knob>images/knob_small.svg</Knob>
        <BackPath>images/knob_small_bg_<Variable name="color"/>.svg</BackPath>
        <MinAngle>-135</MinAngle>
        <MaxAngle>135</MaxAngle>
        <Connection>
          <ConfigKey><Variable name="Control"/></ConfigKey>
        </Connection>
      </KnobComposed>
      <Label>
        <ObjectName>KnobSmallLabel</ObjectName>
        <Text><Variable name="label"/></Text>
        <Size>32f,11f</Size>
      </Label>
    </Children>
  </WidgetGroup>
</Template>

<!DOCTYPE template>
<!-- One wide Beat FX bar with 3 effect slots (selector + ON each). Variables: unit, color -->
<Template>
  <SetVariable name="fxgroup">[EffectRack1_EffectUnit<Variable name="unit"/>]</SetVariable>
  <WidgetGroup>
    <ObjectName>EffectUnit</ObjectName>
    <Layout>horizontal</Layout>
    <SizePolicy>me,min</SizePolicy>
    <Children>
      <Label>
        <ObjectName>EffectUnitLabel</ObjectName>
        <Text>FX<Variable name="unit"/></Text>
        <Size>34f,-1me</Size>
      </Label>
      <Template src="skin:btn_toggle.xml">
        <SetVariable name="ObjectName">EffectAssignButton</SetVariable>
        <SetVariable name="TooltipId">EffectUnit_deck_enabled</SetVariable>
        <SetVariable name="Text">1</SetVariable>
        <SetVariable name="Control"><Variable name="fxgroup"/>,group_[Channel1]_enable</SetVariable>
        <SetVariable name="MinimumSize">30,40</SetVariable>
        <SetVariable name="MaximumSize">30,40</SetVariable>
        <SetVariable name="SizePolicy">f,f</SetVariable>
      </Template>
      <Template src="skin:btn_toggle.xml">
        <SetVariable name="ObjectName">EffectAssignButton</SetVariable>
        <SetVariable name="TooltipId">EffectUnit_deck_enabled</SetVariable>
        <SetVariable name="Text">2</SetVariable>
        <SetVariable name="Control"><Variable name="fxgroup"/>,group_[Channel2]_enable</SetVariable>
        <SetVariable name="MinimumSize">30,40</SetVariable>
        <SetVariable name="MaximumSize">30,40</SetVariable>
        <SetVariable name="SizePolicy">f,f</SetVariable>
      </Template>
      <Template src="skin:btn_toggle.xml">
        <SetVariable name="ObjectName">EffectAssignButton</SetVariable>
        <SetVariable name="TooltipId">EffectUnit_deck_enabled</SetVariable>
        <SetVariable name="Text">M</SetVariable>
        <SetVariable name="Control"><Variable name="fxgroup"/>,group_[Master]_enable</SetVariable>
        <SetVariable name="MinimumSize">30,40</SetVariable>
        <SetVariable name="MaximumSize">30,40</SetVariable>
        <SetVariable name="SizePolicy">f,f</SetVariable>
      </Template>
      <WidgetGroup>
        <ObjectName>EffectSlotBig</ObjectName>
        <Layout>horizontal</Layout>
        <SizePolicy>me,f</SizePolicy>
        <MinimumSize>0,46</MinimumSize>
        <MaximumSize>-1,46</MaximumSize>
        <Children>
          <Template src="skin:btn_toggle.xml">
            <SetVariable name="ObjectName">EffectOnButton</SetVariable>
            <SetVariable name="TooltipId">EffectSlot_enabled</SetVariable>
            <SetVariable name="Text">ON</SetVariable>
            <SetVariable name="Control">[EffectRack1_EffectUnit<Variable name="unit"/>_Effect1],enabled</SetVariable>
            <SetVariable name="MinimumSize">40,38</SetVariable>
            <SetVariable name="MaximumSize">40,38</SetVariable>
            <SetVariable name="SizePolicy">f,f</SetVariable>
          </Template>
          <Template src="skin:knob_small.xml">
            <SetVariable name="TooltipId">EffectSlot_metaknob</SetVariable>
            <SetVariable name="Control">[EffectRack1_EffectUnit<Variable name="unit"/>_Effect1],meta</SetVariable>
            <SetVariable name="color"><Variable name="color"/></SetVariable>
            <SetVariable name="label">META</SetVariable>
          </Template>
          <EffectSelector>
            <ObjectName>EffectSelectorBox<Variable name="color"/></ObjectName>
            <TooltipId>EffectSlot_focus</TooltipId>
            <EffectRack>1</EffectRack>
            <EffectUnit><Variable name="unit"/></EffectUnit>
            <Effect>1</Effect>
            <Elide>right</Elide>
            <MinimumSize>0,38</MinimumSize>
            <MaximumSize>-1,38</MaximumSize>
            <SizePolicy>me,f</SizePolicy>
          </EffectSelector>
        </Children>
        <Connection>
          <ConfigKey><Variable name="fxgroup"/>,focused_effect</ConfigKey>
          <BindProperty>highlight</BindProperty>
          <Transform><IsEqual>1</IsEqual></Transform>
        </Connection>
      </WidgetGroup>
      <WidgetGroup>
        <ObjectName>EffectSlotBig</ObjectName>
        <Layout>horizontal</Layout>
        <SizePolicy>me,f</SizePolicy>
        <MinimumSize>0,46</MinimumSize>
        <MaximumSize>-1,46</MaximumSize>
        <Children>
          <Template src="skin:btn_toggle.xml">
            <SetVariable name="ObjectName">EffectOnButton</SetVariable>
            <SetVariable name="TooltipId">EffectSlot_enabled</SetVariable>
            <SetVariable name="Text">ON</SetVariable>
            <SetVariable name="Control">[EffectRack1_EffectUnit<Variable name="unit"/>_Effect2],enabled</SetVariable>
            <SetVariable name="MinimumSize">40,38</SetVariable>
            <SetVariable name="MaximumSize">40,38</SetVariable>
            <SetVariable name="SizePolicy">f,f</SetVariable>
          </Template>
          <Template src="skin:knob_small.xml">
            <SetVariable name="TooltipId">EffectSlot_metaknob</SetVariable>
            <SetVariable name="Control">[EffectRack1_EffectUnit<Variable name="unit"/>_Effect2],meta</SetVariable>
            <SetVariable name="color"><Variable name="color"/></SetVariable>
            <SetVariable name="label">META</SetVariable>
          </Template>
          <EffectSelector>
            <ObjectName>EffectSelectorBox<Variable name="color"/></ObjectName>
            <TooltipId>EffectSlot_focus</TooltipId>
            <EffectRack>1</EffectRack>
            <EffectUnit><Variable name="unit"/></EffectUnit>
            <Effect>2</Effect>
            <Elide>right</Elide>
            <MinimumSize>0,38</MinimumSize>
            <MaximumSize>-1,38</MaximumSize>
            <SizePolicy>me,f</SizePolicy>
          </EffectSelector>
        </Children>
        <Connection>
          <ConfigKey><Variable name="fxgroup"/>,focused_effect</ConfigKey>
          <BindProperty>highlight</BindProperty>
          <Transform><IsEqual>2</IsEqual></Transform>
        </Connection>
      </WidgetGroup>
      <WidgetGroup>
        <ObjectName>EffectSlotBig</ObjectName>
        <Layout>horizontal</Layout>
        <SizePolicy>me,f</SizePolicy>
        <MinimumSize>0,46</MinimumSize>
        <MaximumSize>-1,46</MaximumSize>
        <Children>
          <Template src="skin:btn_toggle.xml">
            <SetVariable name="ObjectName">EffectOnButton</SetVariable>
            <SetVariable name="TooltipId">EffectSlot_enabled</SetVariable>
            <SetVariable name="Text">ON</SetVariable>
            <SetVariable name="Control">[EffectRack1_EffectUnit<Variable name="unit"/>_Effect3],enabled</SetVariable>
            <SetVariable name="MinimumSize">40,38</SetVariable>
            <SetVariable name="MaximumSize">40,38</SetVariable>
            <SetVariable name="SizePolicy">f,f</SetVariable>
          </Template>
          <Template src="skin:knob_small.xml">
            <SetVariable name="TooltipId">EffectSlot_metaknob</SetVariable>
            <SetVariable name="Control">[EffectRack1_EffectUnit<Variable name="unit"/>_Effect3],meta</SetVariable>
            <SetVariable name="color"><Variable name="color"/></SetVariable>
            <SetVariable name="label">META</SetVariable>
          </Template>
          <EffectSelector>
            <ObjectName>EffectSelectorBox<Variable name="color"/></ObjectName>
            <TooltipId>EffectSlot_focus</TooltipId>
            <EffectRack>1</EffectRack>
            <EffectUnit><Variable name="unit"/></EffectUnit>
            <Effect>3</Effect>
            <Elide>right</Elide>
            <MinimumSize>0,38</MinimumSize>
            <MaximumSize>-1,38</MaximumSize>
            <SizePolicy>me,f</SizePolicy>
          </EffectSelector>
        </Children>
        <Connection>
          <ConfigKey><Variable name="fxgroup"/>,focused_effect</ConfigKey>
          <BindProperty>highlight</BindProperty>
          <Transform><IsEqual>3</IsEqual></Transform>
        </Connection>
      </WidgetGroup>
      <Template src="skin:knob_small.xml">
        <SetVariable name="TooltipId">EffectUnit_mix</SetVariable>
        <SetVariable name="Control"><Variable name="fxgroup"/>,mix</SetVariable>
        <SetVariable name="color">orange</SetVariable>
        <SetVariable name="label">D/W</SetVariable>
      </Template>
    </Children>
  </WidgetGroup>
</Template>

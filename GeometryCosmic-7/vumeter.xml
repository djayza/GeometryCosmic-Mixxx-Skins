<!DOCTYPE template>
<!--
  One vertical VU meter with a peak lamp.
  Variables: group, side (left|right)
-->
<Template>
  <WidgetGroup>
    <ObjectName>VuColumn</ObjectName>
    <Layout>vertical</Layout>
    <Size>10f,-1me</Size>
    <Children>
      <StatusLight>
        <ObjectName>PeakIndicator</ObjectName>
        <TooltipId><Variable name="tip_clip"/></TooltipId>
        <Size>10f,6f</Size>
        <PathStatusLight scalemode="STRETCH">images/peak.svg</PathStatusLight>
        <Connection>
          <ConfigKey><Variable name="group"/>,peak_indicator_<Variable name="side"/></ConfigKey>
        </Connection>
      </StatusLight>
      <VuMeter>
        <ObjectName>VuMeterBar</ObjectName>
        <TooltipId><Variable name="tip_meter"/></TooltipId>
        <Size>10f,-1me</Size>
        <MinimumSize>10,80</MinimumSize>
        <PathBack scalemode="STRETCH">images/vu_bg.png</PathBack>
        <PathVu scalemode="STRETCH">images/vu.png</PathVu>
        <Horizontal>false</Horizontal>
        <PeakHoldSize>3</PeakHoldSize>
        <PeakHoldTime>300</PeakHoldTime>
        <PeakFallTime>20</PeakFallTime>
        <PeakFallStep>1</PeakFallStep>
        <Connection>
          <ConfigKey><Variable name="group"/>,vu_meter_<Variable name="side"/></ConfigKey>
        </Connection>
      </VuMeter>
    </Children>
  </WidgetGroup>
</Template>

<!DOCTYPE template>
<!--
  One hot cue pad.  Variables: group, hotcue (1-8), label (A-H)
-->
<Template>
  <HotcueButton>
    <TooltipId>hotcue</TooltipId>
    <ObjectName>HotcueButton</ObjectName>
    <MinimumSize>20,32</MinimumSize>
    <MaximumSize>60,32</MaximumSize>
    <SizePolicy>me,f</SizePolicy>
    <Group><Variable name="group"/></Group>
    <Hotcue><Variable name="hotcue"/></Hotcue>
    <Hover>true</Hover>
    <NumberStates>3</NumberStates>
    <State>
      <Number>0</Number>
      <Text><Variable name="label"/></Text>
    </State>
    <State>
      <Number>1</Number>
      <Text><Variable name="label"/></Text>
    </State>
    <State>
      <Number>2</Number>
      <Text><Variable name="label"/></Text>
    </State>
  </HotcueButton>
</Template>
